<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小五中文尋寶大冒險 - 地圖尋寶版</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google Fonts 圓體字型 -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    <!-- 引入 Tone.js 用於航海冒險 BGM 音樂與音效 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        body {
            font-family: 'Noto Sans TC', sans-serif;
            background-color: #0284c7; /* 亮藍色海洋背景 */
            color: #1e293b;
            overflow-x: hidden;
        }

        /* 羊皮紙鋸齒邊框外框 */
        .treasure-map-frame {
            background-color: #fef3c7;
            background-image: radial-gradient(#fde68a 15%, transparent 16%), radial-gradient(#fde68a 15%, transparent 16%);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
            border: 12px solid #b45309;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4), inset 0 0 40px rgba(180, 83, 9, 0.3);
        }

        /* 彈跳動畫 */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(1deg); }
        }
        .animate-float {
            animation: float 3s infinite ease-in-out;
        }

        @keyframes celebrate {
            0% { transform: scale(1) rotate(0deg); }
            25% { transform: scale(1.15) rotate(-6deg); }
            50% { transform: scale(1.15) rotate(6deg); }
            100% { transform: scale(1) rotate(0deg); }
        }
        .animate-celebrate {
            animation: celebrate 0.5s ease-in-out;
        }

        .btn-cartoon {
            transition: all 0.15s ease;
            box-shadow: 0 6px 0 rgba(0, 0, 0, 0.2);
        }
        .btn-cartoon:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 rgba(0, 0, 0, 0.2);
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start p-2 sm:p-4">

    <!-- ==================== 頂部導航與航海控制列 ==================== -->
    <header class="w-full max-w-5xl bg-amber-900/90 text-white rounded-2xl shadow-lg p-4 mb-4 backdrop-blur-sm border-4 border-amber-600 flex flex-wrap items-center justify-between gap-3 z-30">
        <div class="flex items-center gap-3">
            <span class="text-4xl bg-amber-800 p-2 rounded-2xl border-2 border-amber-500">🏴‍☠️</span>
            <div>
                <h1 class="text-xl sm:text-2xl font-black text-amber-200 tracking-wide">小五中文：尋寶大冒險地圖</h1>
                <p class="text-xs sm:text-sm text-amber-300 font-bold">通關五大知識島嶼，解鎖終極寶藏箱！</p>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <!-- 航海音樂開關按鈕 -->
            <button onclick="toggleBGM()" id="bgm-btn" class="btn-cartoon bg-amber-400 hover:bg-amber-300 text-amber-950 px-4 py-2 rounded-xl font-black text-sm flex items-center gap-2">
                <span id="bgm-icon">🔇</span>
                <span id="bgm-text">開啟航海音樂</span>
            </button>

            <!-- 老師自由跳島按鈕 -->
            <button onclick="toggleTeacherUnlock()" id="teacher-unlock-btn" class="btn-cartoon bg-sky-600 hover:bg-sky-500 text-white px-3 py-2 rounded-xl font-bold text-xs sm:text-sm">
                👩‍🏫 老師模式 (自由跳島)
            </button>

            <!-- 星星積分器 -->
            <div class="flex items-center gap-1.5 bg-amber-950 px-3 py-1.5 rounded-full border-2 border-amber-500 shadow-inner">
                <span class="text-xl">⭐</span>
                <span class="font-black text-lg text-amber-400" id="total-stars">0</span>
            </div>
        </div>
    </header>

    <!-- ==================== 航海尋寶地圖主畫面 ==================== -->
    <main class="w-full max-w-5xl treasure-map-frame rounded-3xl p-4 sm:p-8 relative min-h-[650px] flex flex-col justify-between overflow-hidden">

        <!-- 地圖背景裝飾元素 (SVG 航海圖標) -->
        <div class="absolute top-6 right-6 opacity-30 pointer-events-none">
            <!-- 指南針玫瑰 -->
            <svg width="100" height="100" viewBox="0 0 100 100" fill="#92400e">
                <polygon points="50,0 55,40 50,50 45,40" />
                <polygon points="50,100 55,60 50,50 45,60" />
                <polygon points="0,50 40,55 50,50 40,45" />
                <polygon points="100,50 60,55 50,50 60,45" />
                <circle cx="50" cy="50" r="10" fill="#d97706" />
            </svg>
        </div>

        <div class="absolute bottom-10 left-10 opacity-25 pointer-events-none text-6xl">
            🦈 🌀 ⛵
        </div>

        <!-- 標題提示 -->
        <div class="text-center relative z-10 mb-4">
            <span class="bg-amber-600 text-amber-100 font-black px-5 py-1.5 rounded-full text-sm sm:text-base shadow-md border-2 border-amber-400">
                🗺️ 點擊已解鎖的小島，展開中文知識挑戰！
            </span>
        </div>

        <!-- ==================== 五座小島地圖佈局 ==================== -->
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-4 relative z-10 my-auto py-6">

            <!-- 第 1 島：迷霧猜謎島 (引入：修辭 vs 寫作手法) -->
            <div id="island-card-1" onclick="openIslandModal(1)" class="cursor-pointer bg-amber-50 hover:bg-amber-100 border-4 border-amber-600 rounded-3xl p-5 text-center shadow-lg transition transform hover:-translate-y-2 relative flex flex-col items-center justify-between min-h-[220px]">
                <div class="absolute -top-3 -right-3 bg-amber-500 text-white font-black w-8 h-8 rounded-full flex items-center justify-center shadow-md border-2 border-white">1</div>
                <div class="text-5xl animate-float my-2">🏝️</div>
                <div>
                    <h3 class="font-black text-amber-900 text-lg mb-1">迷霧猜謎島</h3>
                    <p class="text-xs font-bold text-amber-700">修辭 vs 寫作手法</p>
                </div>
                <div class="mt-3 w-full">
                    <span id="status-1" class="block bg-amber-200 text-amber-900 font-black text-xs py-1 px-2 rounded-xl">⭐ 當前解鎖！</span>
                </div>
                <div id="lock-1" class="absolute inset-0 bg-slate-900/60 rounded-3xl backdrop-blur-[2px] flex flex-col items-center justify-center text-white font-bold text-sm" style="display:none;">
                    <span class="text-3xl mb-1">🔒</span> 尚未解鎖
                </div>
            </div>

            <!-- 第 2 島：智慧神木島 (說明手法 10題) -->
            <div id="island-card-2" onclick="openIslandModal(2)" class="cursor-pointer bg-emerald-50 hover:bg-emerald-100 border-4 border-emerald-600 rounded-3xl p-5 text-center shadow-lg transition transform hover:-translate-y-2 relative flex flex-col items-center justify-between min-h-[220px] opacity-65 grayscale">
                <div class="absolute -top-3 -right-3 bg-emerald-600 text-white font-black w-8 h-8 rounded-full flex items-center justify-center shadow-md border-2 border-white">2</div>
                <div class="text-5xl animate-float my-2">🌴</div>
                <div>
                    <h3 class="font-black text-emerald-900 text-lg mb-1">智慧神木島</h3>
                    <p class="text-xs font-bold text-emerald-700">舉例與分類說明 (10題)</p>
                </div>
                <div class="mt-3 w-full">
                    <span id="status-2" class="block bg-emerald-200 text-emerald-900 font-black text-xs py-1 px-2 rounded-xl">🔒 未解鎖</span>
                </div>
                <div id="lock-2" class="absolute inset-0 bg-slate-900/60 rounded-3xl backdrop-blur-[2px] flex flex-col items-center justify-center text-white font-bold text-sm">
                    <span class="text-3xl mb-1">🔒</span> 尚未解鎖
                </div>
            </div>

            <!-- 第 3 島：百變角色島 (人物描寫 10題) -->
            <div id="island-card-3" onclick="openIslandModal(3)" class="cursor-pointer bg-sky-50 hover:bg-sky-100 border-4 border-sky-600 rounded-3xl p-5 text-center shadow-lg transition transform hover:-translate-y-2 relative flex flex-col items-center justify-between min-h-[220px] opacity-65 grayscale">
                <div class="absolute -top-3 -right-3 bg-sky-600 text-white font-black w-8 h-8 rounded-full flex items-center justify-center shadow-md border-2 border-white">3</div>
                <div class="text-5xl animate-float my-2">🏔️</div>
                <div>
                    <h3 class="font-black text-sky-900 text-lg mb-1">百變角色島</h3>
                    <p class="text-xs font-bold text-sky-700">人物描寫特訓 (10題)</p>
                </div>
                <div class="mt-3 w-full">
                    <span id="status-3" class="block bg-sky-200 text-sky-900 font-black text-xs py-1 px-2 rounded-xl">🔒 未解鎖</span>
                </div>
                <div id="lock-3" class="absolute inset-0 bg-slate-900/60 rounded-3xl backdrop-blur-[2px] flex flex-col items-center justify-center text-white font-bold text-sm">
                    <span class="text-3xl mb-1">🔒</span> 尚未解鎖
                </div>
            </div>

            <!-- 第 4 島：修辭火山島 (修辭特訓 10題) -->
            <div id="island-card-4" onclick="openIslandModal(4)" class="cursor-pointer bg-purple-50 hover:bg-purple-100 border-4 border-purple-600 rounded-3xl p-5 text-center shadow-lg transition transform hover:-translate-y-2 relative flex flex-col items-center justify-between min-h-[220px] opacity-65 grayscale">
                <div class="absolute -top-3 -right-3 bg-purple-600 text-white font-black w-8 h-8 rounded-full flex items-center justify-center shadow-md border-2 border-white">4</div>
                <div class="text-5xl animate-float my-2">🌋</div>
                <div>
                    <h3 class="font-black text-purple-900 text-lg mb-1">修辭火山島</h3>
                    <p class="text-xs font-bold text-purple-700">十大修辭辨識 (10題)</p>
                </div>
                <div class="mt-3 w-full">
                    <span id="status-4" class="block bg-purple-200 text-purple-900 font-black text-xs py-1 px-2 rounded-xl">🔒 未解鎖</span>
                </div>
                <div id="lock-4" class="absolute inset-0 bg-slate-900/60 rounded-3xl backdrop-blur-[2px] flex flex-col items-center justify-center text-white font-bold text-sm">
                    <span class="text-3xl mb-1">🔒</span> 尚未解鎖
                </div>
            </div>

            <!-- 第 5 島：黃金寶藏洞窟 (終極寶藏) -->
            <div id="island-card-5" onclick="openIslandModal(5)" class="cursor-pointer bg-yellow-50 hover:bg-yellow-100 border-4 border-amber-500 rounded-3xl p-5 text-center shadow-lg transition transform hover:-translate-y-2 relative flex flex-col items-center justify-between min-h-[220px] opacity-65 grayscale">
                <div class="absolute -top-3 -right-3 bg-amber-600 text-white font-black w-8 h-8 rounded-full flex items-center justify-center shadow-md border-2 border-white">5</div>
                <div class="text-5xl animate-float my-2">👑</div>
                <div>
                    <h3 class="font-black text-amber-900 text-lg mb-1">黃金寶藏洞窟</h3>
                    <p class="text-xs font-bold text-amber-700">終極綜合試煉 (10題)</p>
                </div>
                <div class="mt-3 w-full">
                    <span id="status-5" class="block bg-yellow-200 text-amber-900 font-black text-xs py-1 px-2 rounded-xl">🔒 未解鎖</span>
                </div>
                <div id="lock-5" class="absolute inset-0 bg-slate-900/60 rounded-3xl backdrop-blur-[2px] flex flex-col items-center justify-center text-white font-bold text-sm">
                    <span class="text-3xl mb-1">🔒</span> 尚未解鎖
                </div>
            </div>

        </div>

        <!-- 航海進度與鑰匙收集面板 -->
        <div class="bg-amber-100/90 border-2 border-amber-400 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3 relative z-10 mt-4">
            <div class="flex items-center gap-2">
                <span class="text-2xl">🗝️</span>
                <span class="font-black text-amber-900">航海進度：已收集 <span id="key-count">0</span> / 5 把鑰匙</span>
            </div>
            <div class="flex items-center gap-2">
                <div class="flex gap-1">
                    <span id="key-1" class="text-2xl opacity-30 grayscale">🗝️</span>
                    <span id="key-2" class="text-2xl opacity-30 grayscale">🗝️</span>
                    <span id="key-3" class="text-2xl opacity-30 grayscale">🗝️</span>
                    <span id="key-4" class="text-2xl opacity-30 grayscale">🗝️</span>
                    <span id="key-5" class="text-2xl opacity-30 grayscale">👑</span>
                </div>
            </div>
        </div>

    </main>

    <!-- ==================== 任務彈跳視窗 (Modal) ==================== -->
    <div id="island-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-amber-50 border-8 border-amber-600 rounded-3xl max-w-3xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 relative shadow-2xl">
            <!-- 關閉按鈕 -->
            <button onclick="closeIslandModal()" class="absolute top-4 right-4 bg-rose-500 hover:bg-rose-600 text-white font-black w-10 h-10 rounded-full text-xl flex items-center justify-center shadow-md">
                ✕
            </button>

            <!-- 視窗標題 -->
            <div class="flex items-center gap-3 mb-6 pb-3 border-b-4 border-amber-200">
                <span id="modal-icon" class="text-4xl">🏴‍☠️</span>
                <div>
                    <h2 id="modal-title" class="text-2xl font-black text-amber-950">小島任務</h2>
                    <p id="modal-subtitle" class="text-sm font-bold text-amber-800">完成挑戰即可獲得鑰匙！</p>
                </div>
            </div>

            <!-- 動態任務內容載入區 -->
            <div id="modal-body" class="space-y-6">
                <!-- 由 JavaScript 依據關卡動態生成 -->
            </div>
        </div>
    </div>

    <!-- 訊息提示框 (Toast) -->
    <div id="toast-box" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-slate-900 text-white px-6 py-3 rounded-2xl font-bold shadow-2xl z-50 hidden text-center border-2 border-amber-400">
    </div>

    <!-- ==================== JavaScript 遊戲引擎與題庫 ==================== -->
    <script>
        const gameState = {
            unlockedIsland: 1,
            keysCollected: 0,
            bgmPlaying: false
        };

        function updateMapUI() {
            document.getElementById('key-count').textContent = gameState.keysCollected;
            for (let i = 1; i <= 5; i++) {
                const card = document.getElementById(`island-card-${i}`);
                const lock = document.getElementById(`lock-${i}`);
                const status = document.getElementById(`status-${i}`);
                const key = document.getElementById(`key-${i}`);

                if (i <= gameState.unlockedIsland) {
                    card.classList.remove('opacity-65', 'grayscale');
                    lock.style.display = 'none';
                    status.textContent = i === gameState.unlockedIsland ? '⭐ 點擊登島！' : '✅ 已通關！';
                    status.className = i === gameState.unlockedIsland ? 'block bg-amber-400 text-amber-950 font-black text-xs py-1 px-2 rounded-xl animate-pulse' : 'block bg-emerald-200 text-emerald-900 font-black text-xs py-1 px-2 rounded-xl';
                } else {
                    card.classList.add('opacity-65', 'grayscale');
                    lock.style.display = 'flex';
                }

                if (i <= gameState.keysCollected) {
                    key.classList.remove('opacity-30', 'grayscale');
                } else {
                    key.classList.add('opacity-30', 'grayscale');
                }
            }
        }

        function completeIsland(islandNum) {
            playSuccessSound();
            if (islandNum > gameState.keysCollected) {
                gameState.keysCollected = islandNum;
            }
            if (islandNum + 1 > gameState.unlockedIsland && islandNum < 5) {
                gameState.unlockedIsland = islandNum + 1;
            }
            updateMapUI();
            showToast(`🎉 恭喜通關第 ${islandNum} 座小島！獲得寶藏鑰匙！🗝️`);
            setTimeout(closeIslandModal, 1500);
        }

        function toggleTeacherUnlock() {
            gameState.unlockedIsland = 5;
            gameState.keysCollected = 5;
            updateMapUI();
            showToast('👩‍🏫 老師模式：所有小島已全數自由解鎖！');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-box');
            toast.textContent = msg;
            toast.classList.remove('hidden');
            setTimeout(() => { toast.classList.add('hidden'); }, 3500);
        }

        let currentOpenIsland = 1;

        function openIslandModal(islandNum) {
            if (islandNum > gameState.unlockedIsland) {
                showToast('🔒 這座小島還在迷霧中！請先通關前面的島嶼！');
                return;
            }
            currentOpenIsland = islandNum;
            const modal = document.getElementById('island-modal');
            const body = document.getElementById('modal-body');
            const title = document.getElementById('modal-title');
            const subtitle = document.getElementById('modal-subtitle');
            const icon = document.getElementById('modal-icon');

            modal.classList.remove('hidden');
            body.innerHTML = '';

            const configs = {
                1: { title: '第 1 站：迷霧猜謎島', sub: '辨認術語屬於「修辭」還是「寫作手法」', icon: '🏝️', init: initIsland1 },
                2: { title: '第 2 站：智慧神木島', sub: '說明手法段落辨識：舉例、分類、定義 (10題)', icon: '🌴', init: initIsland2 },
                3: { title: '第 3 站：百變角色島', sub: '人物描寫特訓 (10題)', icon: '🏔️', init: initIsland3 },
                4: { title: '第 4 站：修辭火山島', sub: '11種修辭辨識與應用 (10題)', icon: '🌋', init: initIsland4 },
                5: { title: '終點：黃金寶藏洞窟', sub: '終極綜合試煉 (10題)', icon: '👑', init: initIsland5 }
            };

            const cfg = configs[islandNum];
            title.textContent = cfg.title;
            subtitle.textContent = cfg.sub;
            icon.textContent = cfg.icon;
            cfg.init(body);
        }

        function closeIslandModal() {
            document.getElementById('island-modal').classList.add('hidden');
            updateMapUI();
        }

        // Tone.js 航海背景音樂
        let synth, bgmLoop;
        function toggleBGM() {
            const btn = document.getElementById('bgm-btn');
            const icon = document.getElementById('bgm-icon');
            const text = document.getElementById('bgm-text');

            if (!gameState.bgmPlaying) {
                Tone.start();
                synth = new Tone.Synth({
                    oscillator: { type: 'triangle' },
                    envelope: { attack: 0.05, decay: 0.2, sustain: 0.2, release: 0.5 }
                }).toDestination();

                const notes = ['C4', 'E4', 'G4', 'B4', 'C5', 'G4', 'E4', 'D4'];
                let step = 0;
                bgmLoop = new Tone.Loop(time => {
                    synth.triggerAttackRelease(notes[step % notes.length], '8n', time);
                    step++;
                }, '4n').start(0);

                Tone.Transport.bpm.value = 110;
                Tone.Transport.start();

                gameState.bgmPlaying = true;
                icon.textContent = '🎵';
                text.textContent = '關閉音樂';
                showToast('🎵 航海冒險音樂已開啟！');
            } else {
                Tone.Transport.stop();
                if (bgmLoop) bgmLoop.dispose();
                gameState.bgmPlaying = false;
                icon.textContent = '🔇';
                text.textContent = '開啟音樂';
                showToast('🔇 航海音樂已暫停。');
            }
        }

        function playSuccessSound() {
            try {
                const sfx = new Tone.Synth().toDestination();
                sfx.triggerAttackRelease('C5', '8n');
                setTimeout(() => sfx.triggerAttackRelease('G5', '8n'), 150);
            } catch(e) {}
        }

        // =====================================================================
        // 第 1 島：迷霧猜謎島（純術語分類：修辭 vs 寫作手法）
        // =====================================================================
        const island1Data = [
            { term: '【明喻、暗喻、排比】', answer: '修辭', explain: '這些都是常用來修飾文句、增強表達效果的「修辭」手法。' },
            { term: '【舉例說明、分類說明】', answer: '寫作手法', explain: '這些是用來條理清晰地解說事物的「寫作手法」（說明手法）。' },
            { term: '【心理描寫、行為描寫】', answer: '寫作手法', explain: '這些是透過人物的動作和內心來刻劃人物形象的「寫作手法」。' },
            { term: '【擬人、誇張、反復】', answer: '修辭', explain: '這些是賦予物體生命或誇大特點的「修辭」手法。' },
            { term: '【語言描寫、外貌描寫】', answer: '寫作手法', explain: '這些是描寫人物說話與容貌衣著的「寫作手法」。' }
        ];
        let i1Index = 0;

        function initIsland1(container) {
            i1Index = 0;
            renderIsland1Question(container);
        }

        function renderIsland1Question(container) {
            if (i1Index >= island1Data.length) {
                container.innerHTML = `
                    <div class="text-center py-8 space-y-4">
                        <div class="text-6xl animate-bounce">🗝️</div>
                        <h3 class="text-3xl font-black text-amber-900">恭喜通過迷霧猜謎島！</h3>
                        <p class="text-lg font-bold text-slate-700">你成功辨認了所有基礎概念！</p>
