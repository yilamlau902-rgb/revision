            { q: '下列哪一句是「暗喻」？', correct: '失敗是成功之母。', pool: ['弟弟的臉紅得像蘋果。', '失敗是成功之母。', '微風撫摸著我的臉。', '我等得花兒也謝了。'] },
            { q: '「香港有不少離島，例如大嶼山和長洲。」這是甚麼說明手法？', correct: '舉例說明', pool: ['舉例說明', '分類說明', '語言描寫', '明喻'] },
            { q: '「爺爺雙手佈滿老繭，額頭上刻滿皺紋。」這是甚麼描寫？', correct: '外貌描寫', pool: ['外貌描寫', '心理描寫', '行為描寫', '語言描寫'] },
            { q: '「太陽公公露出了慈祥的笑臉。」這是甚麼修辭？', correct: '擬人', pool: ['擬人', '誇張', '暗喻', '排比'] },
            { q: '「這座大廈高得快要衝破雲層了。」這是甚麼修辭？', correct: '誇張', pool: ['誇張', '排比', '明喻', '反復'] },
            { q: '「『大家加油！我們一定能贏！』隊長大聲喊道。」這是甚麼描寫？', correct: '語言描寫', pool: ['語言描寫', '外貌描寫', '心理描寫', '行為描寫'] },
            { q: '「知識是打開智慧大門的鑰匙。」這是甚麼修辭？', correct: '暗喻', pool: ['明喻', '暗喻', '擬人', '誇張'] }
        ];
        let i5Index = 0;
        let currentI5Options = [];
        let currentI5CorrectIdx = 0;

        function initIsland5(container) {
            i5Index = 0;
            renderIsland5Q(container);
        }

        function renderIsland5Q(container) {
            if (i5Index >= island5Data.length) {
                container.innerHTML = `
                    <div class="text-center py-6 space-y-4">
                        <div class="text-7xl animate-bounce">👑📦✨</div>
                        <h3 class="text-3xl font-black text-amber-900">寶箱已開啟！恭喜通關全部小島！</h3>
                        <p class="text-lg font-bold text-slate-700">你集齊了所有鑰匙與黃金皇冠！獲得滿分！</p>
                        <div class="bg-amber-100 p-4 rounded-2xl border-2 border-amber-400 inline-block font-black text-2xl text-amber-800">
                            ⭐ 總得分：${window.totalStars || 45} 顆星星！
                        </div>
                        <div class="pt-2">
                            <button onclick="location.reload()" class="btn-cartoon bg-amber-500 hover:bg-amber-600 text-white font-black px-8 py-3 rounded-2xl text-xl">
                                🔄 重新展開航海冒險
                            </button>
                        </div>
                    </div>
                `;
                return;
            }
            const curr = island5Data[i5Index];
            const shuffled = [...curr.pool].sort(() => Math.random() - 0.5);
            currentI5Options = shuffled;
            currentI5CorrectIdx = shuffled.indexOf(curr.correct);

            container.innerHTML = `
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="bg-amber-200 text-amber-900 font-black px-3 py-1 rounded-full text-sm">終極試煉 第 ${i5Index + 1} / 10 題</span>
                        <span class="text-xs font-bold text-amber-800">黃金寶藏挑戰</span>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border-2 border-amber-300 shadow-sm mb-6">
                        <p class="text-xl sm:text-2xl font-bold text-slate-800">${curr.q}</p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        ${currentI5Options.map((opt, idx) => `
                            <button onclick="checkIsland5(${idx})" class="btn-cartoon bg-white hover:bg-amber-50 border-2 border-amber-300 p-4 rounded-xl text-left font-bold text-lg text-amber-950">
                                ${['A','B','C','D'][idx]}. ${opt}
                            </button>
                        `).join('')}
                    </div>
                    <div id="i5-fb" class="mt-4 text-center font-black text-lg"></div>
                </div>
            `;
        }

        function checkIsland5(choiceIdx) {
            const fb = document.getElementById('i5-fb');
            if (choiceIdx === currentI5CorrectIdx) {
                window.totalStars = (window.totalStars || 0) + 2;
                document.getElementById('total-stars').textContent = window.totalStars;
                fb.textContent = '🎉 答對了！加 2 顆星！';
                fb.className = 'mt-4 text-center font-black text-lg text-emerald-600';
                setTimeout(() => {
                    i5Index++;
                    renderIsland5Q(document.getElementById('modal-body'));
                }, 900);
            } else {
                fb.textContent = `❌ 不對喔！正確答案是「${currentI5Options[currentI5CorrectIdx]}」`;
                fb.className = 'mt-4 text-center font-black text-lg text-rose-600';
            }
        }

        window.onload = function () {
            updateMapUI();
        };
    </script>
</body>
</html>
